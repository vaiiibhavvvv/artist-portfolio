# MongoDB connection string (from MongoDB Atlas → Connect → Drivers)
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/colorpalette?retryWrites=true&w=majority"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="paste-a-long-random-string-here"

# Cloudinary (sign up at cloudinary.com, see Product Environment Credentials)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin login credentials — used by the seed script (prisma/seed.ts) to create
# the admin user. Change these BEFORE running `npm run db:seed`.
ADMIN_EMAIL="studiocolorpalette@gmail.com"
ADMIN_PASSWORD="Sanju"
